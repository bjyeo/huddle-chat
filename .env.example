# Copy to server/.env (or export in your shell)
PORT=3001
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
DATABASE_PATH=./data/huddle.db
MAX_USERS=10
# Optional: require this code to register
INVITE_CODE=
# Browser origin of the app (CORS + websocket Origin check). Use your public URL in production.
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies (nginx, Caddy...) in front of the server; 0 = none
TRUST_PROXY=0
