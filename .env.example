# Copy to server/.env (or export in your shell)
PORT=3001
# Required in production: a unique random value of at least 32 characters (placeholders are refused).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left empty in development, a random secret is used and sessions reset on restart.
JWT_SECRET=
DATABASE_PATH=./data/huddle.db
MAX_USERS=10
# Code new members must enter to register. Required in production unless ALLOW_OPEN_REGISTRATION=true.
INVITE_CODE=
# Set to true to run a production server with open registration (no INVITE_CODE) on purpose.
ALLOW_OPEN_REGISTRATION=false
# Browser origin of the app (CORS + websocket Origin check). Use your public URL in production.
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies (nginx, Caddy...) in front of the server; 0 = none
TRUST_PROXY=0
